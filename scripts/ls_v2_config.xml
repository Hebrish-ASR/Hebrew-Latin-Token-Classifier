<View>
  <Style>.lsf-richtext, .htx-richtext {font-size:1.25em}</Style>
  <HyperText name="note" value="$note" inline="true"/>
  <Labels name="tag" toName="text">
    <Label value="HEB" background="#e8590c" hotkey="h"/>
    <Label value="SHARED" background="#1c7ed6" hotkey="s"/>
  </Labels>
  <Text name="text" value="$text" granularity="word"/>
  <View visibleWhen="region-selected">
    <Header value="Selected span: set only if it is an exception (blank = hebrew / standard)" size="6"/>
    <Choices name="lang" toName="text" perRegion="true" choice="single" showInline="true">
      <Choice value="yiddish"/>
      <Choice value="aramaic"/>
      <Choice value="arabic"/>
    </Choices>
    <Choices name="hebrew_variant" toName="text" perRegion="true" choice="single" showInline="true">
      <Choice value="ashkenazic"/>
      <Choice value="sephardic"/>
    </Choices>
  </View>
  <Choices name="sentence" toName="text" choice="single" showInline="true">
    <Choice value="can't decide" hotkey="d"/>
  </Choices>
</View>
